<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>            <string>com.example.crm-mcp</string>
  <key>ProgramArguments</key>
  <array>
    <string>{{NODE_PATH}}</string>
    <string>{{SERVER_PATH}}</string>
  </array>
  <key>WorkingDirectory</key> <string>{{PROJECT_DIR}}</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>          <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
    <key>MCP_HTTP_PORT</key> <string>{{MCP_HTTP_PORT}}</string>
    <key>MCP_TOKEN</key>     <string>{{MCP_TOKEN}}</string>
    <key>MCP_CRM_DB_PATH</key><string>{{MCP_CRM_DB_PATH}}</string>
  </dict>
  <key>StandardOutPath</key>  <string>{{LOG_DIR}}/crm-mcp.log</string>
  <key>StandardErrorPath</key><string>{{LOG_DIR}}/crm-mcp.log</string>
  <key>RunAtLoad</key>        <true/>
  <key>KeepAlive</key>        <true/>
</dict>
</plist>
