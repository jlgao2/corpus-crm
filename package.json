{
  "name": "corpus-crm",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "pipeline": "node pipeline/cli.js",
    "pipeline:no-agents": "SKIP_AGENTS=1 node pipeline/cli.js",
    "portrait": "node pipeline/cli-portrait.js",
    "portrait:test": "node --test pipeline/agents/portrait/*.test.js",
    "build-db": "node --max-old-space-size=8192 pipeline/build-db.js && node pipeline/fix-misclassified-groups.js && node pipeline/cli-merge-identities.js --apply && node pipeline/crm-relink.js",
    "fix-misclassified-groups": "node pipeline/fix-misclassified-groups.js",
    "build-connections": "node pipeline/build-connections.js",
    "context": "node pipeline/cli-context.js",
    "build-photos": "node pipeline/build-photos.js",
    "build-email-summary": "node pipeline/build-email-summary.js",
    "build-youtube": "node pipeline/build-youtube.js",
    "build-fb-events": "node pipeline/build-fb-events.js",
    "build-events": "node pipeline/build-events.js",
    "build-inferred-events": "node pipeline/build-inferred-events.js",
    "build-rhythm": "node pipeline/build-rhythm.js",
    "build-thumbs": "node pipeline/build-thumbs.js",
    "build-calls": "node pipeline/build-calls.js",
    "build-gphotos": "node pipeline/build-gphotos-only.js",
    "faces:export": "node pipeline/build-faces.js export",
    "faces:extract": "pipeline/faces/.venv/bin/python pipeline/faces/face_extract.py",
    "faces:cluster": "pipeline/faces/.venv/bin/python pipeline/faces/face_cluster.py",
    "faces:sheets": "pipeline/faces/.venv/bin/python pipeline/faces/make_contact_sheets.py",
    "faces:caption": "pipeline/faces/.venv/bin/python pipeline/faces/caption.py",
    "build-faces": "node pipeline/build-faces.js",
    "mcp": "node pipeline/mcp-server.js",
    "mcp:test": "node --test pipeline/mcp/*.test.js",
    "mcp:install-launchd": "bash -c 'set -a; [ -f .sync.env ] && . ./.sync.env; node pipeline/install-mcp-launchd.js install'",
    "mcp:uninstall-launchd": "node pipeline/install-mcp-launchd.js uninstall",
    "crm:relink": "node pipeline/crm-relink.js",
    "refresh": "node pipeline/refresh.js",
    "refresh:install-launchd": "node pipeline/install-refresh-launchd.js install",
    "refresh:uninstall-launchd": "node pipeline/install-refresh-launchd.js uninstall",
    "whatsapp:listen": "node pipeline/whatsapp-listen.js",
    "whatsapp:install-launchd": "node pipeline/install-whatsapp-launchd.js install",
    "whatsapp:uninstall-launchd": "node pipeline/install-whatsapp-launchd.js uninstall",
    "partiful:fetch": "node pipeline/ingest/partiful-fetch.js",
    "partiful:backfill": "node pipeline/ingest/partiful-fetch.js --mbox",
    "partiful:login": "node pipeline/ingest/partiful-guests.js --login",
    "partiful:guests": "node pipeline/ingest/partiful-guests.js",
    "merge-identities": "node pipeline/cli-merge-identities.js",
    "merge-case-variants": "node pipeline/merge-case-variant-identities.js",
    "find-dups": "node pipeline/find-dup-identities.js",
    "apply-merges": "node pipeline/apply-merges.js",
    "scan-birthdays": "node pipeline/scan-birthdays.js",
    "serve": "node pipeline/serve.js",
    "build-relations": "node pipeline/build-relations.js",
    "build-storyline": "node pipeline/build-storyline.js",
    "build-groups": "node pipeline/build-groups.js",
    "build-cohorts": "node pipeline/build-cohorts.js",
    "build-mentions": "node pipeline/build-mentions.js",
    "crm:dev": "node --watch pipeline/crm-server.js",
    "crm:start": "node pipeline/crm-server.js",
    "crm:test": "node --test pipeline/crm-server/test/*.test.js",
    "crm:migrate": "node pipeline/migrate-localstorage-to-sqlite.js",
    "crm:install-launchd": "node pipeline/install-launchd.js install",
    "crm:uninstall-launchd": "node pipeline/install-launchd.js uninstall",
    "dev:all": "concurrently -n vite,api -c blue,green \"npm:dev\" \"npm:crm:dev\"",
    "release": "bash scripts/release.sh",
    "release:prune": "bash scripts/prune-releases.sh",
    "release:prune:apply": "bash scripts/prune-releases.sh --apply",
    "demo": "DATA_DIR=./pipeline/output-demo node pipeline/serve.js",
    "demo:build-db": "node scripts/generate-demo-db.mjs",
    "mcp:demo": "MCP_DUCKDB_PATH=pipeline/output-demo/raw/messages.duckdb MCP_PORTRAITS_DIR=pipeline/output-demo/portraits MCP_CRM_DB_PATH=/tmp/demo-crm.sqlite node pipeline/mcp-server.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.91.1",
    "@duckdb/node-api": "^1.5.2-r.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "better-sqlite3": "^12.9.0",
    "express": "^5.2.1",
    "qrcode-terminal": "^0.12.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "imapflow": "^1.6.5",
    "mailparser": "^3.9.9",
    "mbox-reader": "^1.2.0",
    "playwright": "^1.62.1",
    "qrcode": "^1.5.4"
  },
  "license": "SEE LICENSE IN LICENSE.md",
  "description": "Personal message-archive pipeline: ingest → identity resolution → DuckDB corpus → HTML viewer, with a CRM annotation layer and an MCP server.",
  "engines": {
    "node": ">=22"
  }
}
